{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linetech",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-20",
  "vars": {
    "SUPABASE_URL": "https://vbaomkixvrtuuujcodii.supabase.co"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/workspace*",
      "/chat*",
      "/admin*",
      "/handover*"
    ]
  },
  "secrets": {
    "required": [
      "SUPABASE_PUBLISHABLE_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "771001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_SIGNUP_RATE_LIMITER",
      "namespace_id": "771002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AUTH_RECOVER_RATE_LIMITER",
      "namespace_id": "771003",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "AUTH_PASSWORD_RATE_LIMITER",
      "namespace_id": "771004",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PROJECT_REQUEST_RATE_LIMITER",
      "namespace_id": "771005",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "771006",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "771007",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
