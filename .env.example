# LINETECH public site
NEXT_PUBLIC_SITE_URL=https://linetech.aiengineer77.workers.dev

# Supabase — add values only after the dedicated LINETECH project is created.
# The publishable key is safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SECRET_KEY=
